    <script>
        document.addEventListener('DOMContentLoaded', function() {
            let rows = document.querySelectorAll('#recordsTable tr');
            let accNoMap = {};

            rows.forEach((row, index) => {
                let accNo = row.getAttribute('data-acc-no');
                let postDate = row.getAttribute('data-post-date');
                
                if (!accNo || !postDate) {
                    console.warn(`Missing data on row 1`);
                    return;
                }

                let key = accNo + '|' + postDate;

                if (accNoMap[key]) {
                    row.querySelector('.stamp-col').textContent = 'Y';
                    accNoMap[key].querySelector('.stamp-col').textContent = 'Y';
                } else {
                    accNoMap[key] = row;
                    console.log(`Added to accNoMap: `);
                }
            });
        });
    </script>
